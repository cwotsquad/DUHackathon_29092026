# ---------------------------------------------------------------
# Ewakuacja – Rzeszów: pliki pomijane w repozytorium
# ---------------------------------------------------------------

# Środowisko i pliki Pythona (odtwarzane przez start.bat / requirements.txt)
.venv/
venv/
__pycache__/
*.py[cod]

# Dane w cache/ SĄ w repozytorium – mapa domyślna działa bez pobierania:
#   rzeszow.json (OSM), rzeszow_bdot.json + 1863_GML.zip (BDOT10k), punkty_schronienia.csv (PSP).
# Pomijamy tylko pośrednie odpowiedzi Overpass zapisywane przez osmnx (<hash>.json) –
# aplikacja ich nie czyta.
cache/[0-9a-f]*[0-9a-f].json

# Materiały organizatora hackathonu (nie są częścią kodu)
*.pdf

# Dokumenty Markdown
*.md

# Ustawienia lokalne narzędzi i edytorów
.claude/
.idea/
.vscode/

# Pliki systemowe i logi
.DS_Store
Thumbs.db
desktop.ini
*.log
